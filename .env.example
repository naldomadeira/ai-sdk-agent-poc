# Copy to .env.local and fill in. Never commit secrets (.env* is git-ignored, except this file).
# Copie para .env.local e ajuste. Nunca commite segredos.
# As senhas de banco abaixo são defaults do Postgres LOCAL do docker-compose, não credenciais reais.

# --- Banco (docker compose sobe o Postgres em 5467) ---
DATABASE_URL=postgres://commerce:commerce_dev_password@localhost:5467/commerce
# Conexão usada SOMENTE por queryDatabase. O runner de migrations cria esta role com SELECT restrito.
DATABASE_READONLY_URL=postgres://agent_readonly:agent_readonly_dev_password@localhost:5467/commerce

# Bancos de teste (usados pelo Vitest; o init do docker cria commerce_test)
TEST_DATABASE_URL=postgres://commerce:commerce_dev_password@localhost:5467/commerce_test
TEST_DATABASE_READONLY_URL=postgres://agent_readonly:agent_readonly_dev_password@localhost:5467/commerce_test

# --- LLM ---
# Provider Anthropic (ou qualquer gateway compatível com a API da Anthropic via ANTHROPIC_BASE_URL).
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_MODEL=claude-haiku-4-5-20251001

# --- Segurança ---
# Assina as aprovações humanas (HMAC). Gere com: openssl rand -hex 32
TOOL_APPROVAL_SECRET=

# --- Limites de queryDatabase ---
AGENT_QUERY_TIMEOUT_MS=3000
AGENT_QUERY_MAX_ROWS=100

# --- MCP: usuário de serviço em nome do qual o servidor MCP opera ---
MCP_PRINCIPAL_ID=u_bruno
