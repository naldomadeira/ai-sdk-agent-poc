{
  "name": "ai-sdk-agent-poc",
  "version": "0.1.0",
  "description": "Experimental Next.js + AI SDK architecture for application agents, domain tools, database capabilities, human approval, workflows and MCP.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3467",
    "build": "next build",
    "start": "next start --port 3467",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "mcp": "tsx scripts/mcp-server.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "tsx scripts/smoke-agent.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/react": "^4.0.119",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ai": "^7.0.116",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.4.1"
}
